# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Project-specific large files and artifacts
images_checkpoints/
videos_checkpoints/
logs/

# Model weights & data dumps
*.pth
*.pt
*.ckpt
*.h5
*.bin
*.onnx
# checkpoints/ itself is tracked: its metadata.json files carry the thresholds
# and label maps the engines read, and they are tiny. Only the weights beside
# them are excluded — by the rules above plus this one, since the adapters are
# exported as safetensors rather than .bin.
*.safetensors

# Runtime artifacts — every one of these is regenerated by running the app,
# and each grew large enough during testing to be worth naming explicitly:
# uploads reached 151 MB and the preprocessing cache 15 MB after a single
# afternoon of submissions.
server/uploads/*
!server/uploads/.gitkeep
server/_dtp_cache/
server/_dtp_logs/
preprocessed/
*.npy

# SQLite case database plus its write-ahead log. This is local test data, and
# committing it means every clone inherits someone else's cases.
*.db
*.db-wal
*.db-shm

# Next.js build output. client/.gitignore already covers this for the app
# itself; repeated here so a build run from the repo root cannot slip 200 MB
# of .next/ into a commit.
.next/
out/

# Environment & Dependencies
.env
.venv
env/
venv/
ENV/
node_modules/

# Web / Extension build output
/client/dist/
/client/build/
/extension/dist/
/extension/build/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db